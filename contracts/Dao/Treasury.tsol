	event usdtRateLog(address asset, uint256 usdtAmount, uint256 outAmount);

	function usdtRate(address asset, uint256 _usdtAmount) public view returns (uint256 outAmount) {
    uint256 n = assetPriceFeed.length;
    for (uint256 i = 0; i < n; i++) {
        if (asset == assetPriceFeed[i].asset && _usdtAmount >= 10) {
            
            uint256 RATE = assetPriceFeed[i].rate;  // Wvenom smallest units per 1 USDT token
            
            // For Wvenom: RATE = 7316096730 
            // This means: 1 USDT token = 7,316,096,730 Wvenom smallest units
            
          
            outAmount = (_usdtAmount * RATE) / 1e6;
			emit usdtRateLog(asset, _usdtAmount, outAmount);
            break;
        }
    }
}

function updatePriceFeeds(priceFeedUSDT[] newPriceFeeds) public onlyOwner {
	delete assetPriceFeed; 
	uint256 n = newPriceFeeds.length;
	for (uint256 i = 0; i < n; i++) {
		require(newPriceFeeds[i].asset != address(0), INVALID_ADDRESS);
		require(newPriceFeeds[i].rate > 0, INVALID_RATE);
		require(newPriceFeeds[i].decimals > 0, INVALID_DECIMALS);
		newPriceFeeds[i].lastUpdatedTimeStamp = block.timestamp;
		assetPriceFeed.push(newPriceFeeds[i]);
	}
	emit PriceFeedsUpdated(newPriceFeeds);	
}
	
	
	function removeUserDeposits(address user, uint256[] indices) internal {
		require(indices.length > 0, NO_DEPOSITS_FOUND);

		sortAscending(indices);

		uint256 originalLength = userDeposits[user].length;
		bool[] skip = new bool[](originalLength); // Skip list to mark removal

		for (uint256 i = 0; i < indices.length; i++) {
			uint256 index = indices[i];
			require(index < originalLength, INDEX_OUT_OF_BOUNDS);

			skip[index] = true;
		}

		uint256 remainingCount;
		for (uint256 i = 0; i < originalLength; i++) {
			if (!skip[i]) {
				remainingCount++;
			}
		}

		User[] newDeposits = new User[](remainingCount);
		uint256 j;
		for (uint256 i = 0; i < originalLength; i++) {
			if (!skip[i]) {
				newDeposits[j] = userDeposits[user][i];
				j++;
			}
		}

		userDeposits[user] = newDeposits;
	}

	function sortAscending(uint256[] data) internal pure {
		uint256 n = data.length;
		for (uint256 i = 0; i < n; i++) {
			for (uint256 j = i + 1; j < n; j++) {
				if (data[i] > data[j]) {
					// Swap values
					(data[i], data[j]) = (data[j], data[i]);
				}
			}
		}
	}

	function getCallbackAmount() public view {
		treasuryOwner.transfer({value: 1 ever, flag: 128, bounce: false});
	}

	function updateGovernance(
		address _newGovernance
	) external onlyOwnerOrDepositingAddress {
		require(_newGovernance != address(0), INVALID_ADDRESS);
		address oldGovernance = governance;
		governance = _newGovernance;
		emit GovernanceUpdated(oldGovernance, _newGovernance);
	}

