	function onAcceptTokensTransfer(
		address tokenRoot,
		uint128 /*amount*/,
		address /*sender*/,
		address /*senderWallet*/,
		address remainingGasTo,
		TvmCell /*payload */
	) external override {
		rootToWallet[tokenRoot] = msg.sender;
		remainingGasTo.transfer({value: 0, flag: 64});
	}

	function calculateSumOfRatios(uint8[] _ratios) public pure {
		// require(_ratios.length == 5, "Need ratios for 5 assets");
		uint8 sum = 0;
		uint n = _ratios.length;
		for (uint8 i = 0; i < n; i++) {
			sum += _ratios[i];
		}
		require(sum == 100, INVALID_RATIO);
	}

	function getEligibleWithdrawDetails(
		address _userAddress
	) external view returns (uint256[], User[]) {
		uint256 userDepositCount = userDeposits[_userAddress].length;
		require(userDepositCount > 0, NO_DEPOSITS_FOUND);

		uint256 eligibleCount = 0;

		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleCount++;
			}
		}

		uint256[] eligibleIndices = new uint256[](eligibleCount);
		User[] eligibleUsers = new User[](eligibleCount);
		uint256 index = 0;

		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleIndices[index] = i;
				eligibleUsers[index] = userDeposits[_userAddress][i];
				index++;
			}
		}

		return (eligibleIndices, eligibleUsers);
	}

	function deposit_admin(
		address[] users,
		uint256[] usdtAmounts
	) external onlyOwnerOrDepositingAddress {
		uint256[] daiAmounts = usdtAmounts;
		require(users.length == daiAmounts.length, LENGTH_MISMATCH);
		uint256 totalAmount = calculateTotalDeposit(users, daiAmounts);
		uint256 daiAmountToSwap = totalAmount;

		deposit(daiAmountToSwap);

		uint256 lengthh = users.length;
		for (uint256 i = 0; i < lengthh; i++) {
			User newUserDeposit = User({
				treasuryDeposit: daiAmounts[i],
				firstDepositTime: block.timestamp
			});

			userDeposits[users[i]].push(newUserDeposit);

			treasuryBalances[users[i]] += daiAmounts[i];
			updateTopTreasuryHolders(users[i]);
		}

		totalTreasuryPoints += totalAmount;
		emit DepositBatch(lengthh, totalAmount);
	}

	function deposit(uint256 usdtAmount) internal view {
		uint256 daiAmount = usdtAmount;

		uint256 n = assets.length;

		for (uint256 i = 1; i < n; i++) {
			uint256 amountIn = (daiAmount * assetAllocationRatio[i]) / 100;

			makeSwap(
				1,
				assets[0],
				uint128(amountIn),
				assets[i],
				assetsDexPairs[i - 1],
				1 ever,
				0,
				address(this)
			);
		}
	}

	// function getUserDeposits() external view returns (User[]) {
	// 	return userDeposits[msg.sender];
	// }


	function _transferAllNFTs(address collection) internal {
		uint256 totalLocked = contractlockedNFTs[address(this)][collection]
			.length;
		for (uint256 i = 0; i < totalLocked; i++) {
			uint256 tokenId = contractlockedNFTs[address(this)][collection][i];

			TvmCell payload = abi.encode(tokenId);

			localCallbacks[treasuryOwner] = ICallbackParamsStructure
				.CallbackParams({value: 0.05 ever, payload: payload});

			INft(collection).transfer(
				treasuryOwner,
				treasuryOwner,
				localCallbacks
			);
			emit unLocked(collection, tokenId, totalLocked);
		}
	}
	  function changeAssetAllocations(
        address[]  _assets,
        uint256[]  _assetsdecimals,
        uint8[]  _assetAllocationRatio,
        address[]  _priceFeed
    ) external onlyOwner {
        assets = _assets;
        assetsdecimals = _assetsdecimals;
        assetAllocationRatio = _assetAllocationRatio;
        priceFeed = _priceFeed;
    }

	function updateTopTreasuryHolders(address user) internal {
		require(msg.sender == treasuryOwner, ONLY_OWNER_CAN_CALL);
		if (treasuryBalances[user] > 0) {
			if (isTopTreasuryHolder[user]) {
				uint256 index = treasuryHolderIndex[user];
				topTreasuryHolders[index] = user;
			} else {
				uint len = topTreasuryHolders.length;
				if (len < 10) {
					topTreasuryHolders.push(user);
					isTopTreasuryHolder[user] = true;
					treasuryHolderIndex[user] = topTreasuryHolders.length - 1;
				} else {
					_replaceSmallestHolder(user);
				}
			}
			sortTopHolders();
		} else {
			if (isTopTreasuryHolder[user]) {
				uint256 index = treasuryHolderIndex[user];
				_removeTopHolder(user, index);
			}
		}
	}

	function _replaceSmallestHolder(address newUser) internal {
		address smallestHolder = topTreasuryHolders[0];
		uint256 smallestBalance = treasuryBalances[smallestHolder];
		uint256 indexToReplace = 0;

		uint256 len = topTreasuryHolders.length;
		for (uint256 i = 1; i < len; i++) {
			address holder = topTreasuryHolders[i];
			if (treasuryBalances[holder] < smallestBalance) {
				smallestHolder = holder;
				smallestBalance = treasuryBalances[holder];
				indexToReplace = i;
			}
		}

		uint256 newUserBalance = treasuryBalances[newUser];
		if (newUserBalance > smallestBalance) {
			_removeTopHolder(smallestHolder, indexToReplace);
			topTreasuryHolders[indexToReplace] = newUser;
			treasuryHolderIndex[newUser] = indexToReplace;
			isTopTreasuryHolder[newUser] = true;
		}
	}

	function setLockPeriod(uint _lockupPeriod) external onlyOwner {
		FULL_TERM_LOCK_PERIOD = _lockupPeriod;
	}

	function updateDepositingAddress(address _newAddress) external onlyOwner {
		depositingAddress = _newAddress;
	}

	function setForceUnlock(bool _forceUnlock) external onlyOwner {
		forceUnlock = _forceUnlock;
	}

	function sortTopHolders() internal {
		uint256 n = topTreasuryHolders.length;
		if (n <= 1) {
			return; // No need to sort if there is only one or no holder
		}

		// Bubble Sort Algorithm to sort topTreasuryHolders by their balances in descending order
		for (uint256 i = 0; i < n - 1; i++) {
			for (uint256 j = 0; j < n - i - 1; j++) {
				address holder1 = topTreasuryHolders[j];
				address holder2 = topTreasuryHolders[j + 1];

				// Compare balances of holder1 and holder2
				if (treasuryBalances[holder1] < treasuryBalances[holder2]) {
					// Swap the positions
					(topTreasuryHolders[j], topTreasuryHolders[j + 1]) = (
						topTreasuryHolders[j + 1],
						topTreasuryHolders[j]
					);

					// Update the treasuryHolderIndex mapping
					treasuryHolderIndex[holder1] = j + 1;
					treasuryHolderIndex[holder2] = j;
				}
			}
		}
	}


	function _removeTopHolder(address user, uint256 index) internal {
        require(isTopTreasuryHolder[user], NOT_TOP_HOLDER);

        uint256 lastIndex = topTreasuryHolders.length - 1;
        if (index < lastIndex) {
            address lastHolder = topTreasuryHolders[lastIndex];
            topTreasuryHolders[index] = lastHolder;
            treasuryHolderIndex[lastHolder] = index;
        }

        topTreasuryHolders.pop();
        isTopTreasuryHolder[user] = false;
        delete treasuryHolderIndex[user];
    }

	function makeSwap(
        uint64 queryId,
        address tokenIn,
        uint128 amountIn,
        address tokenOut,
        address pair,
        uint128 deployWalletValue,
        uint128 expectedAmountOut,
        address treasuryAddress
    ) public view {
        address tokenWallet = rootToWallet[tokenIn];
        require(address.makeAddrNone() != tokenWallet, WALLET_NOT_EXISTS);
        IGasValueStructure.GasValue gas = GasValues.getPoolDirectExchangeGas(0.1 ever, address(0));
        uint128 gasValue = gas.dynamicGas + gas.fixedValue;
        require(msg.value >= gasValue, NOT_ENOUGH_VALUE);
        TvmCell e;
        TvmCell swapPayload = PairPayload.buildExchangePayloadV2(
            queryId,
            deployWalletValue,
            expectedAmountOut,
            treasuryAddress,
            tokenOut,
            address(0),
            e,
            e,
            null
        );

        ITokenWallet(tokenWallet).transfer{value: 0, flag: 64}(
            amountIn,
            pair,
            deployWalletValue,
            treasuryAddress,
            true,
            swapPayload
        );
		tvm.rawReserve(5 ever, 0);
		treasuryOwner.transfer({value: 0, flag: TokenMsgFlag.ALL_NOT_RESERVED, bounce: false});
		
    	emit madeSwap(tokenIn,tokenOut,amountIn);


        
    }


	function dexPairExchangeSuccess(
		uint64 id,
		bool /* via_account */,
		IExchangeResult.ExchangeResult result
	) external pure {
		emit SwapSuccess(id, result);
	}

	function calculateTotalDeposit(
		address[] users,
		uint256[] daiAmounts
	) public pure returns (uint256 totalAmount) {
		uint256 _totalAmount = 0;
		uint256 n = daiAmounts.length;

		for (uint256 i = 0; i < n; i++) {
			require(daiAmounts[i] > 0, ZERO_AMOUNT);
			require(users[i] != address(0), INVALID_USER);

			_totalAmount += daiAmounts[i];
		}
		return _totalAmount;
	}

	function setUserDepositData(
		address[] users,
		uint256[] daiAmounts
	) external onlyOwner {
		require(users.length == daiAmounts.length, LENGTH_MISMATCH);

		uint256 totalAmount = calculateTotalDeposit(users, daiAmounts);
		uint256 lengthh = users.length;
		for (uint256 i = 0; i < lengthh; i++) {
			User newUserDeposit = User({
				treasuryDeposit: daiAmounts[i],
				firstDepositTime: block.timestamp
			});

			// Push the new deposit entry into the userDeposits array
			userDeposits[users[i]].push(newUserDeposit);

			// Update the overall treasury balance
			treasuryBalances[users[i]] += daiAmounts[i];
		}

		// Update total treasury points
		totalTreasuryPoints += totalAmount;
		emit DepositBatch(lengthh, totalAmount);
	}

	function setDeedEmissionRate(uint256 _deedEmissionRate) external onlyOwner {
		DEED_EMISSION_RATE = _deedEmissionRate;
	}

	function setAllocationRatios(uint8[] _allocationRatios) public onlyOwner {
		calculateSumOfRatios(_allocationRatios);
		assetAllocationRatio = _allocationRatios;
	}

	event balance(address root, uint256 amount);
	mapping(address => address) public walletToRoot;
	mapping(address => uint128) private tempBalances;
	struct balanceOfStruct {
		address root;
		uint128 amount;
	}
	balanceOfStruct[] public balanceOfArray;


	address private tempRootAddress;

	function getAllTokenBalOfContract() public {
		delete balanceOfArray;

		uint256 n = assets.length;
		for (uint256 i = 0; i < n; i++) {
			address wallet = rootToWallet[assets[i]];
			if (wallet != address(0)) {
				walletToRoot[wallet] = assets[i];

				ITokenWallet(wallet).balance{
					value: 0.5 ever,
					flag: 64,
					callback: Treasury.onGetBalance
				}();
			}
		}
	}
	function onGetBalance(uint128 bal) public {
		address root = walletToRoot[msg.sender];

		balanceOfStruct b = balanceOfStruct({root: root, amount: bal});
		balanceOfArray.push(b);
		tempBalances[root] = bal;
		if (assets.length == balanceOfArray.length && drainTreasuryInProgress) {
			drainTreasuryInProgress = false;
			drainTreasuryInternal();
		} else if (
			withdrawInProgress && assets.length == balanceOfArray.length
		) {

			withdrawInProgress = false;
			tempWithdrawStruct p = pendingWithdrawals;
			uint256[] indices = p.indices;
			address user = p.user;
			withdrawInternal(user, indices);
		}

		emit balance(root, bal);
	}


	function drainTreasury() public {
		require(msg.sender == treasuryOwner, ONLY_OWNER_CAN_CALL);
		drainTreasuryInProgress = true;
		getAllTokenBalOfContract();
	}

	function drainTreasuryInternal() internal {
		balanceOfStruct[] balArray = getBalances();
		uint256 n = balArray.length;

		for (uint256 i = 0; i < n; i++) {
			address root = balArray[i].root;
			uint256 bal = balArray[i].amount;
			if (root != address(0)) {
				address wallet = rootToWallet[root];
				if (wallet != address(0) && bal > 0) {
					TvmCell e;

					ITokenWallet(wallet).transfer{value: 2 ever, flag: 64}({
						amount: uint128(bal),
						recipient: treasuryOwner,
						deployWalletValue: 1 ever,
						remainingGasTo: treasuryOwner,
						notify: true,
						payload: e
					});
				}
			}
		}

		_transferAllNFTs(deedNFT);
		_transferAllNFTs(founderNFT);
		tvm.rawReserve(5 ever, 0);
		treasuryOwner.transfer({
			value: 0,
			flag: TokenMsgFlag.ALL_NOT_RESERVED,
			bounce: false
		});
	}

	function getBalances() public view returns (balanceOfStruct[]) {
		return balanceOfArray;
	}

	
	
	
	function withdraw(uint256[] indices) external {
		require(withdrawInProgress == false, WITHDRAW_IN_PROGRESS);
		
		withdrawInProgress = true;

		tempWithdrawStruct tempWithdraw = tempWithdrawStruct({
			user: msg.sender,
			indices: indices,
			timeStamp: block.timestamp
		});
		 
		pendingWithdrawals = tempWithdraw;
		
		getAllTokenBalOfContract();
		
	}
	
	
	function withdrawInternal(address user, uint256[] indices) public {
		uint256 totalAmount;

		uint256 userDepositCount = userDeposits[user].length;
		require(userDepositCount > 0, NO_VALID_DEPOSITS);

		// Calculate total amount eligible for withdrawal
		uint256 cnt = indices.length;
		// uint256 userPrimaryTokenUnlockingAmt; // usdt user share

		for (uint256 i = 0; i < cnt; i++) {
			require(indices[i] < userDepositCount, INVALID_INDEX);
			User userDeposit = userDeposits[user][indices[i]];
			// require(
			// 	block.timestamp >=
			// 		userDeposit.firstDepositTime + FULL_TERM_LOCK_PERIOD,
			// 	DEPOSIT_NOT_ELIGIBLE
			// );

			
			totalAmount += userDeposit.treasuryDeposit; //in Usdt 6 decimals
			userDeposit.treasuryDeposit = 0;
			userDeposit.firstDepositTime = 0; // Set deposit to 0 to prevent double withdrawal
			
		}
		require(totalAmount > 0, NO_VALID_DEPOSITS);

		
		// Calculate total user deposit assets in USDT after a year
		uint256 totalAmountInUsd;
		uint256 len = assets.length;

		for (uint256 i = 1; i < len; i++) {
			
			uint256 userShare = totalAmount; 
			uint256 assetPriceInUsd;

			
			totalAmountInUsd += assetPriceInUsd;
			
			if (assets[i] == assets[0]) {
			
			uint256 share = (userShare * assetAllocationRatio[0])/100;
			if(share > 0){
				TvmCell e;
				ITokenWallet(_distributedTokenWallet).transfer{
				value: 2 ever, flag: 64}
				({
					amount: uint128(share),
					recipient: mainWallet,
					deployWalletValue: 10000,
					remainingGasTo: treasuryOwner,
					notify: true,
					payload: e
					});
			}
			

			} else {
				emit swaplog(assets[i], assets[0], userShare);
				uint256 userDaiShareInUsdt = (userShare * assetAllocationRatio[i])/100;

				uint256 swapAmtInDai = usdtRate(assets[i],userDaiShareInUsdt);
				
				makeSwap(
				1,
				assets[i],
				uint128(swapAmtInDai),
				assets[0],
				assetsDexPairs[i - 1],
				1 ever,
				0,
				treasuryOwner
			);
			TvmCell e;
			ITokenWallet(_distributedTokenWallet).transfer{
			value: 3 ever,
			flag: 64
				}({
					amount: uint128(userDaiShareInUsdt),
					recipient: mainWallet,
					deployWalletValue: 10000,
					remainingGasTo: treasuryOwner,
					notify: true,
					payload: e
					});
				
			}
		}


		uint256 totalamount2 = totalAmount;
		uint256 totalDepositInUsd = totalamount2;
		
		uint256 feePercentage = totalDepositInUsd > (totalDepositInUsd * 2)
			? 20
			: 10;


	

		uint256 feeAmount = totalDepositInUsd * feePercentage / 100;

		uint256 amountAfterFee = totalDepositInUsd - feeAmount;

		uint256 daiAmountToMint = (amountAfterFee * DEED_EMISSION_RATE * 10 ** 6) / (10 ** 6);
		
		totalTreasuryPoints -= totalAmount;
		// // // Update treasury points for user
		treasuryBalances[user] -= totalAmount;

		// // Remove withdrawn deposits from userDeposits array
		removeUserDeposits(user, indices);
		// emit Withdraw(msg.sender, totalAmount, daiAmountToMint);

		// TvmCell e;
		// // // IDeedToken(deedToken).mintForTreasury(msg.sender, daiAmountToMint);
		// ITokenRoot(deedToken).mint{value: 0, flag: 64}({
        //     amount: uint128(daiAmountToMint),
        //     recipient: user,
        //     deployWalletValue: 1 ever,
        //     remainingGasTo: treasuryOwner,
        //     notify: true,
        //     payload: e
        // });
	emit Debug("withdrawInternal",msg.sender,1);
	// mintForTreasury(user, uint128(daiAmountToMint));

	TvmCell e;
	ITokenRoot(deedToken).mint{value: 2 ever, flag: 64}({
            amount: uint128(daiAmountToMint),
            recipient: user,
            deployWalletValue: 1 ever,
            remainingGasTo: treasuryOwner,
            notify: true,
            payload: e
        });
	}
event Debug(string msg,address sender,uint128 amount);

