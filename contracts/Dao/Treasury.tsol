	function calculateSumOfRatios(uint8[] _ratios) public pure {
		// require(_ratios.length == 5, "Need ratios for 5 assets");
		uint8 sum = 0;
		uint n = _ratios.length;
		for (uint8 i = 0; i < n; i++) {
			sum += _ratios[i];
		}
		require(sum == 100, INVALID_RATIO);
	}

	// Error codes
	uint16 public constant ONLY_OWNER_CAN_CALL = 226;
	uint16 public constant NOT_OWNER_OR_GOVERNANCE = 227;
	uint16 public constant NOT_DEPOSITING_ADDRESS_OR_OWNER = 228;

	modifier onlyGovernance() {
		require(msg.sender == governance, ONLY_OWNER_CAN_CALL);
		_;
	}

	modifier onlyOwnerOrGovernance() {
		require(
			msg.sender == treasuryOwner || msg.sender == governance,
			NOT_OWNER_OR_GOVERNANCE
		);
		_;
	}

	modifier onlyOwnerOrDepositingAddress() {
		require(
			msg.sender == treasuryOwner || msg.sender == depositingAddress,
			NOT_DEPOSITING_ADDRESS_OR_OWNER
		);
		_;
	}
	uint16 public constant NO_DEPOSITS_FOUND = 219;

	function getEligibleWithdrawDetails(
		address _userAddress
	) external view returns (uint256[], User[]) {
		uint256 userDepositCount = userDeposits[_userAddress].length;
		require(userDepositCount > 0, NO_DEPOSITS_FOUND);

		uint256 eligibleCount = 0;

		// Calculate how many eligible deposits there are
		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleCount++;
			}
		}

		// Create arrays to store eligible indices and User details
		uint256[] eligibleIndices = new uint256[](eligibleCount);
		User[] eligibleUsers = new User[](eligibleCount);
		uint256 index = 0;

		// Populate arrays with the eligible indices and User details
		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleIndices[index] = i;
				eligibleUsers[index] = userDeposits[_userAddress][i];
				index++;
			}
		}

		return (eligibleIndices, eligibleUsers);
	}

	uint16 public constant LENGTH_MISMATCH = 229;
	uint16 public constant TRANSFER_FAILED = 230;

	function onDeployWallet(address _wallet) public {
		require(msg.sender == assets[0], 166);
		require(_wallet != address(0), 132);
		assetsZeroWallet = _wallet;
