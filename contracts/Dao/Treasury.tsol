	function onNftAddress(address value) external {
		require(value != address(0), INVALID_ADDRESS);

		nftAddressOfIdMock[uint256(9999999999999)] = value;
		emit onCollectionEvent(value);

		Nft(value).getInfo{
			value: 0.2 ever,
			flag: 1,
			callback: Treasury.onNftOwner
		}();
	}

	function onNftOwner(
		uint256 id,
		address owner,
		address /*manager*/,
		address collection
	) external {
		require(owner != address(0), INVALID_ADDRESS);

		nftOwnerOfId[collection][id] = owner;
		address mockNFT = nftAddressOfIdMock[9999999999999];
		nftAddressOfId[collection][id] = mockNFT;

		nftAddressOfIdMock[9999999999999] = address(0);

		emit onNFTEvent(mockNFT);

		lockNFTInternal(owner, collection, id);
	}

	function lockNFTInternal(
		address user,
		address collectionAddress,
		uint256 tokenId
	) internal accept {
		require(
			!_isLocked(user, collectionAddress, tokenId),
			NFT_LOCKED_OR_NOT_OWNED
		);
		require(
			nftOwnerOfId[collectionAddress][tokenId] == user,
			NOT_NFT_OWNER
		);
		address _nftAddr = nftAddressOfId[collectionAddress][tokenId];
		require(_nftAddr != address(0), INVALID_ADDRESS);

		TvmCell payload = abi.encode(tokenId);

		localCallbacks[address(this)] = ICallbackParamsStructure
			.CallbackParams({value: 0.05 ever, payload: payload});

		INft(_nftAddr).transfer{value: 1 ever, flag: 1}(
			address(this),
			user,
			localCallbacks
		);
		emit nftDeposited(user, _nftAddr, tokenId);

		// lockedDeedNFTBalance[msg.sender]++;
		lockTimestamps[user][collectionAddress][tokenId] = block.timestamp;
		lockedNFTs[user][collectionAddress].push(tokenId);
		contractlockedNFTs[address(this)][collectionAddress].push(tokenId);
		emit NFTLocked(user, collectionAddress, tokenId);
	}

	function lockDeedNFTInternal(
		address user,
		address collectionAddress,
		uint256 tokenId
	) internal accept {
		require(!_isLocked(user, founderNFT, tokenId), NFT_LOCKED_OR_NOT_OWNED);
		require(
			nftOwnerOfId[collectionAddress][tokenId] == user,
			NOT_NFT_OWNER
		);
		address _nftAddr = nftAddressOfId[collectionAddress][tokenId];
		require(_nftAddr != address(0), INVALID_ADDRESS);

		TvmCell payload = abi.encode(tokenId);

		localCallbacks[address(this)] = ICallbackParamsStructure
			.CallbackParams({value: 0.05 ever, payload: payload});

		INft(_nftAddr).transfer{value: 1 ever, flag: 1}(
			address(this),
			user,
			localCallbacks
		);
		emit nftDeposited(user, _nftAddr, tokenId);

		// lockedDeedNFTBalance[msg.sender]++;
		lockTimestamps[user][founderNFT][tokenId] = block.timestamp;
		lockedNFTs[user][founderNFT].push(tokenId);
		contractlockedNFTs[address(this)][founderNFT].push(tokenId);
		emit NFTLocked(user, founderNFT, tokenId);
	}

	function unlockNFT(address collectionAddress, uint256 _tokenId) external {
		require(
			_isLocked(msg.sender, collectionAddress, _tokenId),
			NFT_LOCKED_OR_NOT_OWNED
		);

		require(
			forceUnlock ||
				block.timestamp >=
				lockTimestamps[msg.sender][collectionAddress][_tokenId] +
					FULL_TERM_LOCK_PERIOD,
			NFT_STILL_LOCKED_TERM_NOT_ENDS
		);

		// _removeLockedNFT(msg.sender, collectionAddress, _tokenId);

		uint256[] lockedTokens = lockedNFTs[msg.sender][collectionAddress];
		emit unLocked(collectionAddress, _tokenId, lockedTokens.length);
		require(lockedTokens.length > 0, NO_VALID_DEPOSITS);
		uint256 length = lockedTokens.length;
		for (uint256 i = 0; i < length; i++) {
			if (lockedTokens[i] == _tokenId) {
				lockedTokens[i] = lockedTokens[length - 1];
				lockedTokens.pop();
				break;
			}
		}
		emit unLocked(collectionAddress, _tokenId, lockedTokens.length);
		lockedNFTs[msg.sender][collectionAddress] = lockedTokens;
		uint256[] tokens = contractlockedNFTs[address(this)][collectionAddress];
		uint256 lengthh = tokens.length;
		for (uint256 i = 0; i < lengthh; i++) {
			if (tokens[i] == _tokenId) {
				tokens[i] = tokens[lengthh - 1];
				tokens.pop();
				break;
			}
		}
		address _nftAddr = nftAddressOfId[collectionAddress][_tokenId];
		TvmCell payload = abi.encode(_tokenId);

		localCallbacks[address(this)] = ICallbackParamsStructure
			.CallbackParams({value: 0.05 ever, payload: payload});

		INft(_nftAddr).transfer{value: 1 ever, flag: 1}(
			msg.sender,
			msg.sender,
			localCallbacks
		);
		emit nftDeposited(msg.sender, _nftAddr, _tokenId);

		emit NFTUnlocked(msg.sender, collectionAddress, _tokenId);
	}

	function getTopTreasuryHolders()
		public
		view
		responsible
		returns (address[])
	{
		return {value: 0, flag: 64, bounce: false} (topTreasuryHolders);
	}

	function _isLocked(
		address user,
		address collectionAddress,
		uint256 tokenId
	) internal view returns (bool) {
		uint256[] lockedTokens = lockedNFTs[user][collectionAddress];
		uint256 length = lockedTokens.length;
		for (uint256 i = 0; i < length; i++) {
			if (lockedTokens[i] == tokenId) {
				return true;
			}
		}
		return false;
	}

	function _removeLockedNFT(
		address user,
		address collectionAddress,
		uint256 tokenId
	) internal view{
		uint256[] lockedTokens = lockedNFTs[user][collectionAddress];
		emit unLocked(collectionAddress, tokenId, lockedTokens.length);

		uint256 length = lockedTokens.length;
		for (uint256 i = 0; i < length; i++) {
			if (lockedTokens[i] == tokenId) {
				lockedTokens[i] = lockedTokens[length - 1];
				lockedTokens.pop();
				break;
			}
		}
		emit unLocked(collectionAddress, tokenId, lockedTokens.length);
	}

	function getLockedNFTs(
		address user,
		address collectionAddress
	) external view returns (uint256[]) {
		return lockedNFTs[user][collectionAddress];
	}

	function getTreasuryBalance(
		address _user
	) external view responsible override returns (uint256, address) {
		return
			{value: 0, flag: 64, bounce: false} (
				treasuryBalances[_user],
				_user
			);
	}

	function getLockedNFTBalances(
		address _user
	)
		external
		view
		responsible
		override
		returns (LockedNFTBalances balances, address user)
	{
		LockedNFTBalances res = LockedNFTBalances(
			lockedNFTs[_user][deedNFT].length,
			lockedNFTs[_user][founderNFT].length,
			lockedNFTs[_user][genesisNFT].length
		);
		return {value: 0, flag: 64, bounce: false} (res, _user);
	}

