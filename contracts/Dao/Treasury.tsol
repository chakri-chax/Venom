uint32 constant NFT_LOCKED_OR_NOT_OWNED = 257;
uint32 constant NOT_NFT_OWNER = 258;
uint32 constant CONTRACT_NOT_APPROVED = 259;
uint32 constant NFT_STILL_LOCKED_TERM_NOT_ENDS = 260;






	mapping (address => mapping(uint256=>address)) public nftAddressOfId ;

	mapping (address => mapping(uint256=>address)) public nftOwnerOfId ;

	function getNftAddrOfNftIdMap(address collection,uint256 id) public view returns (address){
		return nftAddressOfId[collection][id];
	}
	function getNftOwnerOfNftIdMap(address collection,uint256 id) public view returns (address){
		return nftOwnerOfId[collection][id];
	}













function lockFounderNFT( uint256 id) public {
	address collection = founderNFT;
