		require(amountIn > 0, ZERO_AMOUNT);
		// swap usdt to wvenom and transfer to governance
		// usdt -- wvenom
		makeSwap(
			1,
			assets[0],
			uint128(amountIn),
			assets[1],
			assetsDexPairs[0],
			1 ever,
			0,
			receiver
		);
	}

