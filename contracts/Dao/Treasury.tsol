	function mintForTreasury(address account, uint128 amount) public  {
		tvm.accept();

        TvmCell e;
        // emit Debug("mintDeedToken",msg.sender);
	emit Debug("withdrawInternal",msg.sender,2);

        ITokenRoot(deedToken).mint{value: 0, flag: 64}({
            amount: amount,
            recipient: account,
            deployWalletValue: 1 ever,
            remainingGasTo: treasuryOwner,
            notify: true,
            payload: e
        });
    }

	    mapping(address => IChangeOwnership.CallbackParams) _localCallbacks;
		function changeRootOwner(address newOwner) external view onlyOwner {
        IChangeOwnership(deedToken).transferOwnership{value: 0, flag: 64}({
            newOwner: newOwner,
            remainingGasTo: treasuryOwner,
            callbacks: _localCallbacks
        });
    }
