pragma ever-solidity >=0.62.0;

pragma AbiHeader expire;
pragma AbiHeader time;
pragma AbiHeader pubkey;

import "./ILockedNFT.tsol";

import "@broxus/tip4/contracts/TIP4_2_2/interfaces/ITIP4_2_2Collection.tsol";

import "@broxus/tip4/contracts/TIP4_3/interfaces/ITIP4_3Collection.tsol";

import "./Treasury.tsol";

import "./Nft.tsol";

interface IGovernanceCallback {
	function onLockedNFTBalances(
		LockedNFTBalances balances,
		address user
	) external;
}

contract Governance is IGovernanceCallback {
	uint64 static nonce_;
	enum ProposalType {
		OPEN,
		TREASURY,
		COMPLIANCE,
		TREASURY_MAN,
		BLOCK_USER,
		UNBLOCK_USER
	}

	enum ProposalStatus {
		PENDING,
		LIVE,
		COMPLETED,
		FAILED,
		DELETED
	}

	struct Proposal {
		uint PID;
		address creator;
		address blockAddress;
		string title;
		string description;
		uint vote_start;
		uint vote_end;
		ProposalType ptype;
		ProposalStatus pStatus;
		uint yVotes;
		uint nVotes;
		uint minVotes;
		uint totalVoted;
		uint minPercent;
		uint fundingAmount;
		uint releasedAmount;
		uint startTime;
		uint lastReleaseTime;
		uint claimPercent;
		uint fundingInterval;
		bool isStopped;
		bool funded;
	}

	uint16 public constant ZERO_ADDRESS = 55;
	uint16 public constant INVALID_PROPOSAL = 56;
	uint16 public constant INVALID_TOKEN_ADDRESS = 57;
	uint16 public constant CALLABLE_BY_ADMIN_ONLY = 58;
	uint16 public constant REQUEST_ALREADY_PENDING = 58;
	uint16 public constant FUNDING_LIMIT_EXCEEDED = 59;
	uint16 public constant MIN_PERCENTAGE_TOO_LOW = 60;
	uint16 public constant MIN_VOTERS_TOO_LOW = 61;
	uint16 public constant USER_IS_BLOCKED = 62;
	uint16 public constant AMOUNT_TOO_LOW = 63;
	uint16 public constant FOUNDER_NFT_LOCKED = 64;
	uint16 public constant ONLY_DEED_NFT_HOLDER_CAN_CREATE_OPEN_PROPOSAL = 65;
	uint16 public constant TREASURY_BALANCE_IS_0 = 66;
	uint16
		public constant ONLY_DEED_NFT_HOLDER_OR_COMPLIANCE_MEMBER_CAN_CREATE_PROPOSAL =
		67;

	uint16 public constant INVALID_ID = 68;
	uint16 public constant PROPOSAL_IS_NOT_PENDING_FOR_COMPLIANCE_MEMBERS = 70;

	uint16 public constant INVALID_PROPOSAL_ID = 83; // 83 (reused from earlier INVALID_ID)
	uint16 public constant USER_ALREADY_VOTED = 84; // 84
	uint16 public constant PROPOSAL_NOT_LIVE = 85; // 85
	uint16 public constant VOTING_CLOSED = 86; // 86
	uint16 public constant USER_BLOCKED = 87; // 87
	uint16 public constant DEED_NFT_REQUIRED = 88; // 88
	uint16 public constant TREASURY_BAL_REQUIRED = 89; // 89

	uint16 public constant USER_NOT_VOTED = 90; // 90
	uint16 public constant DEED_NFT_REQUIRED_WITHDRAW = 91; // 91 (reuses same requirement as voting)
	uint16 public constant TREASURY_BAL_REQUIRED_WITHDRAW = 92; // 92 (reuses same requirement as voting)

	uint16 public constant VOTING_NOT_STARTED = 71;
	uint16 public constant INSUFFICIENT_SENDING_AMOUNT = 93;
	uint16 public constant VOTE_NOT_ENDED = 72;
	uint16 public constant CLAIM_PERCENT_NOT_SET = 73;
	uint16 public constant FUNDING_INTERVAL_NOT_SET = 74;

	uint16 public constant INVALID_FUNDING_PROPOSAL = 75;
	uint16 public constant FUNDING_STOPPED = 76;
	uint16 public constant INTERVAL_NOT_DUE = 77;
	uint16 public constant FUNDING_COMPLETED = 78;
	uint16 public constant STATUS_NOT_COMPLETED = 79;
	uint16 public constant NO_FUNDS_AVAILABLE = 80;
	uint16 public constant INVALID_FUNDING_PROPOSAL_ID = 81;
	uint16 public constant ALREADY_FUNDED = 82;
	uint16 public constant BALANCE_SHOULD_NOT_BE_ZERO = 94; // 94

	uint CREATE_PROPOSAL_COST = 1 * 10 ** 9;

	Proposal[] public proposals;

	address public treasury;
	address public admin;

	uint public pendingProposals;
	uint public completedProposals;

	mapping(address => uint[]) public uProposals;

	uint private constant PERCENT = 100;

	mapping(uint => mapping(address => bool)) public complianerVotes;

	mapping(uint => mapping(address => int)) public voterVotes;

	address[] public blacklistedUsers;

	event ProposalAdded(
		uint indexed proposalID,
		address recipient,
		uint amount,
		string description
	);

	event ProposalStatusChanged(uint indexed proposalID, ProposalStatus status);
	event Voted(uint indexed proposalID, bool position, address indexed voter);
	event ProposalTallied(
		uint indexed proposalID,
		bool result,
		uint approvalRate
	);

	address[] public complianceMembers;

	constructor(
		address treasuryAddress,
		address _deedNFT,
		address _founderNFT,
		address _admin,
		address[] _complianers
	) public {
		tvm.accept();
		tvm.rawReserve(1 ever, 0);
		require(
			_deedNFT != address(0) &&
				treasuryAddress != address(0) &&
				_founderNFT != address(0),
			INVALID_TOKEN_ADDRESS
		);
		require(_admin != address(0), ZERO_ADDRESS);

		admin = _admin;
		complianceMembers = _complianers;
		treasury = treasuryAddress;
	}

	address[] private treasureMngQueue;

	function isComplianceMember(address s) public view returns (bool) {
		bool _isComplianer = false;
		for (uint i = 0; i < complianceMembers.length; i++) {
			if (s == complianceMembers[i]) {
				_isComplianer = true;
				break;
			}
		}
		return _isComplianer;
	}

	modifier OnlyComplianceMember() {
		require(isComplianceMember(msg.sender));
		_;
	}
	modifier onlyAdmin() {
		require(msg.sender == admin, CALLABLE_BY_ADMIN_ONLY);
		_;
	}

	function isUserBlacklisted(
		address _user
	) public view returns (bool blacklisted) {
		for (uint i = 0; i < blacklistedUsers.length; i++) {
			if (blacklistedUsers[i] == _user) {
				blacklisted = true;
			}
		}
	}

	fallback() external pure {
		emit CallFailed(505);
	}

	receive() external {}

	struct LockedBal {
		uint256 deedNFTCount;
		uint256 founderNFTCount;
		uint256 genesisNFTCount;
	}

	mapping(address => LockedBal) public userLockedBalance;

	function setLockedNFTBalance(
		uint256 deedNFTCount,
		uint256 founderNFTCount,
		uint256 genesisNFTCount
	) public {
		userLockedBalance[msg.sender] = LockedBal(
			deedNFTCount,
			founderNFTCount,
			genesisNFTCount
		);
	}

	event ProposalCreated(
		uint256 id,
		address creater,
		ProposalType pType,
		uint256 amount
	);

	struct ProposalDraft {
		string title;
		string description;
		uint256 voteStart;
		uint256 voteEnd;
		ProposalType pType;
		uint256 minVoters;
		uint256 minPercent;
		uint256 amount;
		address blockAddress;
	}
	mapping(address => ProposalDraft) public pendingProposalDraft;
	uint32 public INVALID_CALLER = 292;

	event TreasuryBalanceReceived(uint256 value, address user);
	event CallFailed(uint32 errorCode);

	mapping(address => uint256) public tempTreasuryBalance;
	mapping(address => LockedNFTBalances) public tempLockedBalances;

	function createProposalRequest(
		string _title,
		string _description,
		uint _vote_start,
		uint _vote_end,
		ProposalType _ptype,
		uint _minVoters,
		uint _minPercent,
		uint amount,
		address _blockAddress
	) external {
		require(_minPercent > 40, MIN_PERCENTAGE_TOO_LOW);
		require(_minVoters >= 2, MIN_VOTERS_TOO_LOW);
		require(!isUserBlacklisted(msg.sender), USER_IS_BLOCKED);
		uint voteEndTme = block.timestamp;
		require(msg.value == CREATE_PROPOSAL_COST, AMOUNT_TOO_LOW);
		tvm.rawReserve(1 ever, 0);

		pendingProposalDraft[msg.sender] = ProposalDraft(
			_title,
			_description,
			_vote_start,
			voteEndTme,
			_ptype,
			_minVoters,
			_minPercent,
			amount,
			_blockAddress
		);

		Treasury(treasury).getTreasuryBalance{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onTreasuryBalance
		}(msg.sender);

		Treasury(treasury).getLockedNFTBalances{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onLockedNFTBalances
		}(msg.sender);
	}

	function onTreasuryBalance(uint256 value, address user) public {
		require(msg.sender == treasury, INVALID_CALLER);
		tempTreasuryBalance[user] = value;
	}

	function onLockedNFTBalances(
		LockedNFTBalances balances,
		address user
	) external override {
		require(msg.sender == treasury, INVALID_CALLER);
		tempLockedBalances[user] = balances;
		_finalizeProposal(user);
	}

	uint32 constant ZERO_AMOUNT = 300;
	mapping(uint256 => mapping(address => LockedNFTBalances))
		public userNFTsByProposalId;

	function _finalizeProposal(address user) internal {
		ProposalDraft draft = pendingProposalDraft[user];

		if (draft.amount == 0) {
			uint256 treasuryDeposit = tempTreasuryBalance[user];
			LockedNFTBalances LB = tempLockedBalances[user];
			userNFTsByProposalId[proposals.length][user] = LB;
			uint maxFundingAmount = treasuryDeposit *
				100 *
				(LB.deedNFTCount + LB.founderNFTCount);
			require(draft.amount <= maxFundingAmount, FUNDING_LIMIT_EXCEEDED);
			require(LB.founderNFTCount >= 1, FOUNDER_NFT_LOCKED);

			Proposal p;
			p.PID = proposals.length;
			p.creator = user;
			p.title = draft.title;
			p.description = draft.description;
			p.vote_start = draft.voteStart;
			p.vote_end = draft.voteEnd;
			p.minVotes = draft.minVoters;
			p.minPercent = draft.minPercent;
			p.ptype = draft.pType;
			p.fundingAmount = draft.amount;
			p.blockAddress = draft.blockAddress;

			if (p.ptype == ProposalType.COMPLIANCE) {
				p.pStatus = ProposalStatus.LIVE;
			} else {
				pendingProposals++;
			}
			if (p.ptype == ProposalType.OPEN) {
				require(
					LB.deedNFTCount > 0,
					ONLY_DEED_NFT_HOLDER_CAN_CREATE_OPEN_PROPOSAL
				);
			} else if (p.ptype == ProposalType.TREASURY) {
				require(treasuryDeposit > 0, ZERO_AMOUNT);
			} else if (
				p.ptype == ProposalType.BLOCK_USER ||
				p.ptype == ProposalType.UNBLOCK_USER
			) {
				require(
					LB.deedNFTCount > 0 || isComplianceMember(msg.sender),
					ONLY_DEED_NFT_HOLDER_CAN_CREATE_OPEN_PROPOSAL
				);
				p.pStatus = ProposalStatus.LIVE;
			}
			proposals.push(p);
			uProposals[user].push(p.PID);

			emit ProposalCreated(p.PID, user, draft.pType, draft.amount);
			// cleanup
			delete pendingProposalDraft[user];
			delete tempTreasuryBalance[user];
			delete tempLockedBalances[user];
		} else {
			// isFundingProposal[proposals.length] = true;
			getVotingPower(user);
		}
	}

	event step(uint256 s);
	event amout(uint256 a);

	function fundingProposal(
		ProposalDraft draft,
		address user,
		LockedNFTBalances LB,
		uint256 treasuryDeposit
	) public {
		require(draft.amount > 0, ZERO_AMOUNT);
		uint maxFundingAmount = treasuryDeposit *
			100 *
			(LB.deedNFTCount + LB.founderNFTCount);
		require(draft.amount <= maxFundingAmount, FUNDING_LIMIT_EXCEEDED);
		require(LB.founderNFTCount >= 1, FOUNDER_NFT_LOCKED);
		Proposal p;
		p.PID = proposals.length;
		p.creator = user;
		p.title = draft.title;
		p.description = draft.description;
		p.vote_start = draft.voteStart;
		p.vote_end = draft.voteEnd;
		p.minVotes = draft.minVoters;
		p.minPercent = draft.minPercent;
		p.ptype = draft.pType;
		p.fundingAmount = draft.amount;
		p.blockAddress = draft.blockAddress;
		if (p.ptype == ProposalType.COMPLIANCE) {
			p.pStatus = ProposalStatus.LIVE;
		} else {
			pendingProposals++;
		}
		if (p.ptype == ProposalType.OPEN) {
			require(
				LB.deedNFTCount > 0,
				ONLY_DEED_NFT_HOLDER_CAN_CREATE_OPEN_PROPOSAL
			);
		} else if (p.ptype == ProposalType.TREASURY) {
			require(treasuryDeposit > 0, ZERO_AMOUNT);
		} else if (
			p.ptype == ProposalType.BLOCK_USER ||
			p.ptype == ProposalType.UNBLOCK_USER
		) {
			require(
				LB.deedNFTCount > 0 || isComplianceMember(msg.sender),
				ONLY_DEED_NFT_HOLDER_OR_COMPLIANCE_MEMBER_CAN_CREATE_PROPOSAL
			);
			p.pStatus = ProposalStatus.LIVE;
		}
		proposals.push(p);
		uProposals[user].push(p.PID);
		isFundingProposal[p.PID] = false;

		emit ProposalCreated(p.PID, user, draft.pType, draft.amount);
		// cleanup
		delete pendingProposalDraft[user];
		delete tempTreasuryBalance[user];
		delete tempLockedBalances[user];

		delete tempVP_Treasury[user];
		delete tempVP_NFTs[user];
		delete pendingVPRequest[user];
	}

	function isProposalAgreed(uint _pId) internal view returns (bool) {
		uint agreed = 0;
		uint n = complianceMembers.length;
		for (uint i = 0; i < n; i++) {
			if (complianerVotes[_pId][complianceMembers[i]]) {
				agreed += 1;
			}
		}
		if (agreed == 0) return false;
		uint r = agreed * PERCENT;
		uint p = r / complianceMembers.length;
		return p > 50;
	}

	function voteByComplianer(
		uint _propID,
		bool _supports
	) public OnlyComplianceMember returns (bool _success) {
		require(_propID < proposals.length, INVALID_ID);
		require(!isUserBlacklisted(msg.sender), USER_IS_BLOCKED);

		Proposal p = proposals[_propID];

		require(
			p.pStatus == ProposalStatus.PENDING,
			PROPOSAL_IS_NOT_PENDING_FOR_COMPLIANCE_MEMBERS
		);

		complianerVotes[p.PID][msg.sender] = _supports;

		if (p.vote_start < block.timestamp) {
			if (isProposalAgreed(p.PID)) {
				proposals[_propID].pStatus = ProposalStatus.LIVE;
			} else {
				proposals[_propID].pStatus = ProposalStatus.FAILED;
			}
			pendingProposals--;
		}

		_success = true;
	}

	function voteByUser(uint _propID, bool _supports) external {
		require(_propID < proposals.length, INVALID_PROPOSAL_ID);
		Proposal p = proposals[_propID];

		require(voterVotes[_propID][msg.sender] == 0, USER_ALREADY_VOTED);
		require(p.pStatus == ProposalStatus.LIVE, PROPOSAL_NOT_LIVE);

		require(!isUserBlacklisted(msg.sender), USER_BLOCKED);

		pendingVotes[msg.sender] = VoteDraft(_propID, _supports);
		tvm.rawReserve(1 ever, 0);

		Treasury(treasury).getTreasuryBalance{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onTreasuryVoteBalance
		}(msg.sender);

		Treasury(treasury).getLockedNFTBalances{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onNFTVoteBalance
		}(msg.sender);
	}

	mapping(address => uint256) public tempVoteTreasury;
	mapping(address => LockedNFTBalances) public tempVoteNFTs;

	struct VoteDraft {
		uint propID_;
		bool supports_;
	}
	mapping(address => VoteDraft) public pendingVotes;

	function onTreasuryVoteBalance(uint256 value, address user) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempVoteTreasury[user] = value;
	}

	function onNFTVoteBalance(
		LockedNFTBalances balances,
		address user
	) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempVoteNFTs[user] = balances;
		_finalizeVote(user); // finalize when both callbacks complete
	}

	function _finalizeVote(address user) internal {
		VoteDraft vd = pendingVotes[user];
		Proposal p = proposals[vd.propID_];

		uint votes = _calculateVotingPower(
			user,
			tempVoteTreasury[user],
			tempVoteNFTs[user]
		);

		if (
			p.ptype == ProposalType.OPEN ||
			p.ptype == ProposalType.BLOCK_USER ||
			p.ptype == ProposalType.UNBLOCK_USER
		) {
			require(tempVoteNFTs[user].deedNFTCount > 0, DEED_NFT_REQUIRED);
			_applyVote(vd.propID_, user, vd.supports_, votes);
		} else if (p.ptype == ProposalType.TREASURY) {
			require(tempVoteTreasury[user] > 0, TREASURY_BAL_REQUIRED);
			_applyVote(vd.propID_, user, vd.supports_, votes);
		} else if (
			p.ptype == ProposalType.COMPLIANCE && isComplianceMember(user)
		) {
			_applyVote(vd.propID_, user, vd.supports_, 1);
		} else if (
			p.ptype == ProposalType.TREASURY_MAN && isTopTreasury(user)
		) {
			_applyVote(vd.propID_, user, vd.supports_, votes);
		}

		emit Voted(p.PID, vd.supports_, user);

		// cleanup
		delete pendingVotes[user];
		delete tempVoteTreasury[user];
		delete tempVoteNFTs[user];
	}

	event appliedVote(
		uint indexed proposalID,
		address indexed user,
		bool supports_,
		uint votes
	);

	function _applyVote(
		uint propID,
		address voter,
		bool supports_,
		uint votes
	) internal {
		if (supports_) {
			proposals[propID].yVotes += votes;
			voterVotes[propID][voter] = int256(votes);
		} else {
			proposals[propID].nVotes += votes;
			voterVotes[propID][voter] = -int256(votes);
		}
		proposals[propID].totalVoted += 1;

		emit appliedVote(propID, voter, supports_, votes);
	}

	struct WithdrawDraft {
		uint propID_;
		bool supports_;
		int256 votes_;
	}

	mapping(address => WithdrawDraft) public pendingWithdraws;
	mapping(address => uint256) public tempWithdrawTreasury;
	mapping(address => LockedNFTBalances) public tempWithdrawNFTs;

	function withdrawVote(uint _propID) external {
		require(voterVotes[_propID][msg.sender] != 0, USER_NOT_VOTED);
		require(_propID < proposals.length, INVALID_PROPOSAL_ID);

		Proposal p = proposals[_propID];
		int votes = int256(voterVotes[_propID][msg.sender]);
		require(p.pStatus == ProposalStatus.LIVE && votes != 0, VOTING_CLOSED);

		bool _supports = votes > 0;

		// Store draft
		pendingWithdraws[msg.sender] = WithdrawDraft(_propID, _supports, votes);

		// async calls like voteByUser
		Treasury(treasury).getTreasuryBalance{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onTreasuryWithdrawBalance
		}(msg.sender);

		Treasury(treasury).getLockedNFTBalances{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onNFTWithdrawBalance
		}(msg.sender);
	}

	function onTreasuryWithdrawBalance(uint256 value, address user) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempWithdrawTreasury[user] = value;
	}

	function onNFTWithdrawBalance(
		LockedNFTBalances balances,
		address user
	) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempWithdrawNFTs[user] = balances;

		_finalizeWithdraw(user);
	}

	function _finalizeWithdraw(address user) internal {
		WithdrawDraft wd = pendingWithdraws[user];
		Proposal p = proposals[wd.propID_];

		if (
			p.ptype == ProposalType.OPEN ||
			p.ptype == ProposalType.BLOCK_USER ||
			p.ptype == ProposalType.UNBLOCK_USER
		) {
			require(
				tempWithdrawNFTs[user].deedNFTCount > 0,
				DEED_NFT_REQUIRED_WITHDRAW
			);
			_applyWithdraw(wd.propID_, user, wd.supports_, wd.votes_);
		} else if (p.ptype == ProposalType.TREASURY) {
			require(
				tempWithdrawTreasury[user] > 0,
				TREASURY_BAL_REQUIRED_WITHDRAW
			);
			_applyWithdraw(wd.propID_, user, wd.supports_, wd.votes_);
		} else if (
			p.ptype == ProposalType.COMPLIANCE && isComplianceMember(user)
		) {
			_applyWithdraw(wd.propID_, user, wd.supports_, wd.votes_);
		} else if (
			p.ptype == ProposalType.TREASURY_MAN && isTopTreasury(user)
		) {
			_applyWithdraw(wd.propID_, user, wd.supports_, wd.votes_);
		}

		emit VoteWithdrawn(p.PID, wd.supports_, user, wd.votes_);

		// cleanup
		delete voterVotes[wd.propID_][user];
		delete pendingWithdraws[user];
		delete tempWithdrawTreasury[user];
		delete tempWithdrawNFTs[user];
	}

	function _applyWithdraw(
		uint propID,
		address voter,
		bool supports_,
		int256 votes
	) internal {
		if (proposals[propID].ptype == ProposalType.COMPLIANCE) {
			if (supports_) proposals[propID].yVotes -= 1;
			else proposals[propID].nVotes -= 1;
		} else {
			if (supports_) proposals[propID].yVotes -= uint256(votes);
			else {
				int256 result = int256(proposals[propID].nVotes) + votes;
				proposals[propID].nVotes = uint256(result);
			}
		}

		proposals[propID].totalVoted -= 1;
	}

	event VoteWithdrawn(
		uint indexed proposalID,
		bool supports_,
		address indexed user,
		int256 votes
	);

	function _calculateVotingPower(
		address voter,
		uint256 treasuryDeposit,
		LockedNFTBalances LB
	) public pure returns (uint) {
		uint total_votes = LB.deedNFTCount;
		uint votes = total_votes > 11 ? 11 : total_votes;

		uint256 treasuryBal = treasuryDeposit / 1e9;
		if (treasuryBal >= 10) {
			votes *= (treasuryBal / 10);
		}

		votes = votes * (1 + LB.founderNFTCount);
		return votes;
	}

	function makeItLive(uint _propID) public OnlyComplianceMember {
		require(_propID < proposals.length, INVALID_ID);

		Proposal p = proposals[_propID];

		require(p.vote_start < block.timestamp, VOTING_NOT_STARTED);

		if (isProposalAgreed(p.PID)) {
			proposals[_propID].pStatus = ProposalStatus.LIVE;
		} else {
			proposals[_propID].pStatus = ProposalStatus.FAILED;
		}
		pendingProposals--;
	}

	function executeProposal(uint _pId) external OnlyComplianceMember {
		require(_pId < proposals.length, INVALID_ID);
		Proposal p = proposals[_pId];
		uint totalVotes = p.yVotes + p.nVotes;

		if (p.fundingAmount > 0) {
			require(p.claimPercent > 0, CLAIM_PERCENT_NOT_SET);
			require(p.fundingInterval > 0, FUNDING_INTERVAL_NOT_SET);
		}
		uint percent;
		if (p.yVotes > 0) {
			percent = (p.yVotes * PERCENT) / totalVotes;
		} else {
			// Handle the case where yVotes is zero
			percent = 0;
		}

		bool criteria = (percent >= p.minPercent) &&
			(p.totalVoted >= p.minVotes);

		if (!criteria) {
			p.pStatus = ProposalStatus.FAILED;
			emit ProposalTallied(p.PID, false, percent);
			return;
		}

		if (p.ptype == ProposalType.COMPLIANCE) {
			uint256 totalComplianceMembers = complianceMembers.length;
			uint256 complianceVotesNeed = (totalComplianceMembers / 2) + 1;

			bool compliant = p.yVotes >= complianceVotesNeed &&
				isComplianceMember(msg.sender);
			if (!compliant) {
				p.pStatus = ProposalStatus.FAILED;
				emit ProposalTallied(p.PID, false, percent);
				return;
			} else {
				complianceMembers.push(p.creator);
			}
		}

		if (p.fundingAmount > 0) {
			proposals[_pId].isStopped = false;
			proposals[_pId].lastReleaseTime = block.timestamp;
		}

		if (p.ptype == ProposalType.BLOCK_USER) {
			if (!isUserBlacklisted(p.blockAddress)) {
				blacklistedUsers.push(p.blockAddress);
			}
		}

		if (p.ptype == ProposalType.UNBLOCK_USER) {
			_removeFromBlacklist(p.blockAddress);
		}

		p.pStatus = ProposalStatus.COMPLETED;
		completedProposals++;
		emit ProposalStatusChanged(p.PID, ProposalStatus.COMPLETED);
	}

	function _removeFromBlacklist(address _user) internal {
		for (uint i = 0; i < blacklistedUsers.length; i++) {
			if (blacklistedUsers[i] == _user) {
				// Replace the user to remove with the last element
				blacklistedUsers[i] = blacklistedUsers[
					blacklistedUsers.length - 1
				];
				blacklistedUsers.pop();
				break;
			}
		}
	}

	event timestampp(uint256 t);
	event amountt(uint256 a);

	function releaseFunds(uint _proposalId) external {
		Proposal p = proposals[_proposalId];
		require(p.fundingAmount > 0, INVALID_FUNDING_PROPOSAL);
		require(!p.isStopped, FUNDING_STOPPED);
		emit timestampp(block.timestamp);
		emit timestampp(p.lastReleaseTime + p.fundingInterval);
		require(
			block.timestamp >= p.lastReleaseTime + p.fundingInterval,
			INTERVAL_NOT_DUE
		);
		require(!p.funded, FUNDING_COMPLETED);
		require(p.pStatus == ProposalStatus.COMPLETED, STATUS_NOT_COMPLETED);
		require(msg.sender == p.creator || isComplianceMember(msg.sender));
		require(msg.value >= 3 ever, INSUFFICIENT_SENDING_AMOUNT);
		uint128 amountToRelease = uint128(p.fundingAmount * p.claimPercent) /
			100;
		emit amountt(amountToRelease);
		if (p.releasedAmount + amountToRelease <= p.fundingAmount) {
			require(amountToRelease > 0, NO_FUNDS_AVAILABLE);

			Treasury(treasury).swapAndTransferToGovernance{
				value: 3 ever,
				flag: 1
			}(amountToRelease, p.creator);
			// callback: Governance.onFundsReleased
		} else if (p.releasedAmount + amountToRelease > p.fundingAmount) {
			amountToRelease = uint128(p.fundingAmount - p.releasedAmount);
			emit amountt(amountToRelease);
			require(amountToRelease > 0, NO_FUNDS_AVAILABLE);

			Treasury(treasury).swapAndTransferToGovernance{
				value: 3 ever,
				flag: 1
			}(amountToRelease, p.creator);
			// callback: Governance.onFundsReleased
		}

		p.releasedAmount += amountToRelease;
		if (p.releasedAmount == p.fundingAmount) {
			proposals[_proposalId].funded = true;
		}

		p.lastReleaseTime = block.timestamp;
	}

	function swapFunds(uint256 amount, address to) external {
		require(msg.value >= 3 ever, INSUFFICIENT_SENDING_AMOUNT);
		uint256 amountToRelease = amount;
		Treasury(treasury).swapAndTransferToGovernance{value: 3 ever, flag: 1}(
			// callback: Governance.onFundsReleased
			uint128(amountToRelease),
			to
		);
	}

	event FundsReleased(bool success);

	function onFundsReleased(bool success) external {
		emit FundsReleased(success);
	}

	function stopFunding(uint _proposalId) external OnlyComplianceMember {
		Proposal p = proposals[_proposalId];
		proposals[_proposalId].isStopped = true;
	}

	function resumeFunding(uint _proposalId) external OnlyComplianceMember {
		Proposal p = proposals[_proposalId];
		require(p.fundingAmount > 0, INVALID_FUNDING_PROPOSAL_ID);
		require(!p.funded, ALREADY_FUNDED);
		proposals[_proposalId].isStopped = false;
	}

	function setFundingParams(
		uint _proposalId,
		uint256 Interval,
		uint _claimPercemt
	) external OnlyComplianceMember {
		Proposal p = proposals[_proposalId];
		proposals[_proposalId].fundingInterval = Interval;
		proposals[_proposalId].claimPercent = _claimPercemt;
	}

	function isTopTreasury(address sender) internal view returns (bool) {
		// before this function is called, make sure to call getTreasuryManagerQueue()
		// to populate topTreasuryHoldersArr
		address[] topTreasuryHolders = topTreasuryHoldersArr; //ITreasury(treasury).getTopTreasuryHolders();

		uint n = topTreasuryHolders.length;
		for (uint i = 0; i < n; i++) {
			if (topTreasuryHolders[i] == sender) {
				return true;
			}
		}
		return false;
	}

	mapping(address => bool) internal pendingVPRequest;
	mapping(address => LockedNFTBalances) internal tempVP_NFTs;
	mapping(address => uint256) internal tempVP_Treasury;
	// bool public isFundingProposalCheck = false;
	mapping(uint256 => bool) public isFundingProposal;

	// async getter
	function getVotingPower(address voter) public returns (uint) {
		// require(!pendingVPRequest[voter], REQUEST_ALREADY_PENDING);
		tvm.rawReserve(1 ever, 0);

		pendingVPRequest[voter] = true;

		Treasury(treasury).getLockedNFTBalances{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onVP_NFTs
		}(voter);

		Treasury(treasury).getTreasuryBalance{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onVP_Treasury
		}(voter);

		return 0;
	}

	function onVP_NFTs(LockedNFTBalances balances, address user) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempVP_NFTs[user] = balances;
		_finalizeVotingPower(user);
	}

	function onVP_Treasury(uint256 value, address user) external {
		require(msg.sender == treasury, INVALID_CALLER);
		tempVP_Treasury[user] = value;
		isFundingProposal[proposals.length] = true;
		_finalizeVotingPower(user);
	}

	event VotingPowerCalculated(address indexed voter, uint votingPower);

	function _finalizeVotingPower(address user) internal {
		if (tempVP_Treasury[user] == 0 && tempVP_NFTs[user].deedNFTCount == 0) {
			return;
		}

		LockedNFTBalances b = tempVP_NFTs[user];
		uint256 treasuryBal = tempVP_Treasury[user] / 1e9; // adjust decimals if needed

		// start from deed NFT count
		uint totalVotes = b.deedNFTCount > 0 ? b.deedNFTCount : 1;

		// cap deed count at 11
		if (totalVotes > 11) totalVotes = 11;

		// treasury multiplier
		if (treasuryBal >= 10) {
			uint r = treasuryBal / 10;
			totalVotes *= r;
		}

		// exponent factor: founder + genesis
		uint expFactor = 1 + b.founderNFTCount;
		uint votingPower = totalVotes * expFactor;

		emit VotingPowerCalculated(user, votingPower);
		if (isFundingProposal[proposals.length]) {
			fundingProposal(
				pendingProposalDraft[user],
				user,
				tempVP_NFTs[user],
				tempVP_Treasury[user]
			);
		}
	}

	function getTreasuryManagerQueue()
		public
		view
		returns (address[] topTreasuryHoldersArr)
	{
		Treasury(treasury).getTopTreasuryHolders{
			value: 0.2 ever,
			flag: 1,
			callback: Governance.onGetTopTreasuryHolders
		}();
	}

	address[] public topTreasuryHoldersArr;
	event TopTreasuryHoldersReceived(address[] topHolders);

	function onGetTopTreasuryHolders(address[] topTreasuryHolders) external {
		require(msg.sender == treasury, INVALID_CALLER);

		topTreasuryHoldersArr = topTreasuryHolders;
		emit TopTreasuryHoldersReceived(topTreasuryHolders);
	}

	modifier onlyTreasuryContract() {
		require(msg.sender == treasury);
		_;
	}

	function getProposal(uint pID) public view returns (Proposal) {
		require(pID < proposals.length, INVALID_PROPOSAL_ID);
		return proposals[pID];
	}

	function numOfProposals() external view returns (uint) {
		return proposals.length;
	}

	function getCreatorProposals() external view returns (Proposal[]) {
		uint[] upids = uProposals[msg.sender];
		Proposal[] mps = new Proposal[](upids.length);
		uint256 n = upids.length;
		for (uint i = 0; i < n; i++) {
			mps[i] = proposals[upids[i]];
		}
		return mps;
	}

	function getProposalYayVotes(uint _pid) external view returns (uint) {
		require(_pid < proposals.length, INVALID_PROPOSAL_ID); // Reused 83
		return proposals[_pid].yVotes;
	}

	function getProposalNayVotes(uint _pid) external view returns (uint) {
		require(_pid < proposals.length, INVALID_PROPOSAL_ID); // Reused 83
		return proposals[_pid].nVotes;
	}

	function getProposalStatus(
		uint _pid
	) external view returns (ProposalStatus) {
		require(_pid < proposals.length, INVALID_PROPOSAL_ID); // Reused 83
		return proposals[_pid].pStatus;
	}

	function getAllProposals() public view returns (Proposal[]) {
		return proposals;
	}

	function getPendingProposals()
		public
		view
		OnlyComplianceMember
		returns (Proposal[])
	{
		Proposal[] penProps = new Proposal[](pendingProposals);
		uint ci = 0;
		uint256 n = proposals.length;
		for (uint i = 0; i < n; i++) {
			if (proposals[i].pStatus == ProposalStatus.PENDING) {
				penProps[ci] = proposals[i];
				ci++;
			}
		}
		return penProps;
	}

	function getComplianers() public view returns (address[]) {
		return complianceMembers;
	}

	function setTreasury(address _treasury) external onlyAdmin {
		require(_treasury != address(0), ZERO_ADDRESS); // 93
		treasury = _treasury;
	}

	function addComplianer(address _complianer) public onlyAdmin {
		complianceMembers.push(_complianer);
	}

	function removeComplianer(address _complianer) public onlyAdmin {
		uint i = 0;
		uint len = complianceMembers.length;

		for (; i < len; i++) {
			if (complianceMembers[i] == _complianer) {
				break;
			}
		}

		if (i < len) {
			for (uint j = i; j < len - 1; j++) {
				complianceMembers[j] = complianceMembers[j + 1];
			}
			complianceMembers.pop();
		}
	}

	function revokeAdmin(address _newAdmin) public onlyAdmin {
		admin = _newAdmin;
	}

	function getCompletedProposals() public view returns (Proposal[]) {
		Proposal[] comProps = new Proposal[](completedProposals);
		uint ci = 0;
		uint len = proposals.length;
		for (uint i = 0; i < len; i++) {
			if (proposals[i].pStatus == ProposalStatus.COMPLETED) {
				comProps[ci] = proposals[i];
				ci++;
			}
		}
		return comProps;
	}

	function withdrawCreateProposalFee() public view {
		admin.transfer({value: 1 ever, flag: 128, bounce: false});
	}
}
