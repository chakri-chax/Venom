interface IGovernanceCallback {
	function onLockedNFTBalances(
		LockedNFTBalances balances,
		address user
	) external;
}

contract Governance is IGovernanceCallback {
	uint64 static nonce_;
	enum ProposalType {
		OPEN,
		TREASURY,
		COMPLIANCE,
		TREASURY_MAN,
		BLOCK_USER,
		UNBLOCK_USER
	}

	// Enumeration for different statuses of proposals
	enum ProposalStatus {
		PENDING,
		LIVE,
		COMPLETED,
		FAILED,
		DELETED
	}

	// Structure representing a proposal
	struct Proposal {
		uint PID;
		address creator;
		address blockAddress;
		string title;
		string description;
		uint vote_start;
		uint vote_end;
		ProposalType ptype;
		ProposalStatus pStatus;
		uint yVotes;
		uint nVotes;
		uint minVotes;
		uint totalVoted;
		uint minPercent;
		uint fundingAmount;
		uint releasedAmount;
		uint startTime;
		uint lastReleaseTime;
		uint claimPercent;
		uint fundingInterval;
		bool isStopped;
		bool funded;
	}

	uint16 public constant ZERO_ADDRESS = 55;
	uint16 public constant INVALID_PROPOSAL = 56;
	uint16 public constant INVALID_TOKEN_ADDRESS = 57;
	uint16 public constant CALLABLE_BY_ADMIN_ONLY = 58;
	uint CREATE_PROPOSAL_COST = 1 * 10 ** 9;

