	// 	return percentage > 50;
	// }
	// >=50% of compliance members must agree
	event proposalAgreed(uint _pId,uint256 percentage); //(type name);
	function isProposalAgreed(uint _pId) public view returns (bool) {
		uint n = complianceMembers.length;
		if (n == 0) return false; // no members => cannot agree

		uint agreed;
		for (uint i = 0; i < n; i++) {
			if (complianerVotes[_pId][complianceMembers[i]]) {
				agreed += 1;
			}
		}
		if (agreed == 0) return false; // nobody agreed

		// Use simple percent to avoid overflow: (agreed * 100) / n
		uint percent = (agreed * 100) / n;
		return percent >= 10;
		emit proposalAgreed(_pId,percent);
	}

