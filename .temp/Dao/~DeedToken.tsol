pragma ever-solidity >=0.62.0;

pragma AbiHeader expire;
pragma AbiHeader time;
pragma AbiHeader pubkey;
import "../TIP3Root/contracts/interfaces/~ITokenRoot.tsol";
// import "../TIP3Root/contracts/interfaces/~ITransferableOwnership.tsol";

import "../TIP3Root/contracts/interfaces/~ITokenWallet.tsol";
import "../TIP3Root/contracts/interfaces/~IAcceptTokensTransferCallback.tsol";

// import "../TIP3Root/contracts/structures/~ICallbackParamsStructure.tsol";
import "./~Treasury.tsol";

interface IChangeOwnership {
     struct CallbackParams {
        uint128 value;
        TvmCell payload;
    }
    function transferOwnership(
        address newOwner,
        address remainingGasTo,
        mapping(address => CallbackParams) callbacks
    ) external;
}
interface IDeedToken {
	function mintForTreasury(address account, uint128 amount) external;
}

contract DeedToken is IDeedToken  {
	uint64 static nonce_;
	address public deedTokenRoot;
	address public deedTokenWallet;
	address public treasuryOwner;
    mapping(address => IChangeOwnership.CallbackParams) localCallbacks;
	modifier onlyOwner() {
		require(treasuryOwner == msg.sender, 201);
		_;
	}

	constructor(address _deedTokenRoot, address _treasuryOwner) public {
		tvm.accept();
		tvm.rawReserve(2 ever, 0);
		deedTokenRoot = _deedTokenRoot;
		ITokenRoot(deedTokenRoot).deployWallet{
			value: 2 ever,
			callback: onDeployWallet
		}(address(this), 1000000000);

		treasuryOwner = _treasuryOwner;

        
	}

	function onDeployWallet(address wallet) public {
		deedTokenWallet = wallet;
       

	}

    function changeRootOwner(address newOwner) external onlyOwner {
          emit Debug("changeRootOwner",msg.sender);
        IChangeOwnership(deedTokenRoot).transferOwnership{value: 0, flag: 64}({
            newOwner: newOwner,
            remainingGasTo: treasuryOwner,
            callbacks: localCallbacks
        });
    }

	function transferDeedTokens(
		address account,
		uint128 amount
	) external  {
		TvmCell e;
		ITokenWallet(deedTokenWallet).transfer{value: 0, flag: 64}({
			amount: amount,
			recipient: account,
			deployWalletValue: 1 ever,
			remainingGasTo: treasuryOwner,
			notify: true,
			payload: e
		});
	}
    event Debug(string msg,address sender);

    function mintForTreasury(address account, uint128 amount) external override {
        TvmCell e;
        emit Debug("mintDeedToken",msg.sender);

        ITokenRoot(deedTokenRoot).mint{value: 0, flag: 64}({
            amount: amount,
            recipient: account,
            deployWalletValue: 1 ever,
            remainingGasTo: treasuryOwner,
            notify: true,
            payload: e
        });
    }
	event AcceptedTokensTransfer(
		address tokenRoot,
		uint128 amount,
		address sender,
		address senderWallet,
		address remainingGasTo,
		TvmCell payload
	);

	function onAcceptTokensTransfer(
		address tokenRoot,
		uint128 amount,
		address sender,
		address senderWallet,
		address remainingGasTo,
		TvmCell payload
	) external {
		emit AcceptedTokensTransfer(
			tokenRoot,
			amount,
			sender,
			senderWallet,
			remainingGasTo,
			payload
		);
		remainingGasTo.transfer({value: 0, flag: 64, bounce: false});
		deedTokenRoot;
		remainingGasTo;
		payload;
	}

	function getCallbackAmount() public view {
		treasuryOwner.transfer({value: 1 ever, flag: 128, bounce: false});
	}
}
