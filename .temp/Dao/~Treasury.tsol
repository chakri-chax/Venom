}



	function deposit(uint256 daiAmount) public {
    userSwapContext[msg.sender] = SwapContext(daiAmount, 1);
	this._continueSwap{value: 1 ever, flag: 64}(msg.sender);
    // _continueSwap(msg.sender);
	//  Treasury(address(this))._continueSwap{value: 1 ever, flag: 64}(msg.sender);
}
uint64 private nextQueryId;
event ContinueSwapTriggered(address user, uint8 index, uint256 amount,address tokenIn, address tokenOut,address pair);
event _continueSwapIndex(uint64 index);

function _continueSwap(address user) public {

	require(msg.sender == address(this), 104);

    SwapContext ctx = userSwapContext[user];
	emit _continueSwapIndex(ctx.currentIndex);
    if (ctx.currentIndex >= assets.length) {
        // delete userSwapContext[user];
		// emit AllSwapsCompleted(user);
        return; // All swaps complete
    }

    uint256 amountIn = (ctx.totalAmount * assetAllocationRatio[ctx.currentIndex]) / 100;
 		nextQueryId += 1;
        uint64 queryId = nextQueryId;
        swapQueryToUser[queryId] = user;
    	makeSwap(
        queryId, 
        assets[0],
        uint128(amountIn),
        assets[ctx.currentIndex],
        assetsDexPairs[ctx.currentIndex],
        1 ever,
        0,
        address(this)
    );
	emit ContinueSwapTriggered(user, ctx.currentIndex, amountIn,assets[0],assets[ctx.currentIndex],assetsDexPairs[ctx.currentIndex ]);

  
}
fallback() external {
    tvm.accept();
    // Optional logging here
}

