	uint16 public constant MISMATCHED_ARRAYS_LENGTH = 223;
	uint16 public constant INVALID_ADDRESS = 224;
	uint16 public constant INVALID_ASSET = 225;
	uint16 public constant INVALID_RATIO = 222;

	constructor(
		address[] _assets,
		uint256[] _assetsdecimals,
		uint8[] _assetAllocations,
		address[] _assetsDexPairs,
		address _owner,
		address _deedNFT,
		address _founderNFT,
		// address _genesisNFT,
		address _mainWallet,
		address[] _priceFeed,
		address _deedToken,
		address _DaiToEthPriceFeed,
		address _depositingAddress,
		address _WETH,
		uint64 _nonce,
		address exchangeContractAddress
	) public {
		tvm.accept();
		tvm.rawReserve(0.5 ever, 0);
		require(_assets.length == _priceFeed.length, MISMATCHED_ARRAYS_LENGTH);
		require(
			_assets.length == _assetsdecimals.length,
			MISMATCHED_ARRAYS_LENGTH
		);
		require(
			_assets.length - 1 == _assetsDexPairs.length,
			MISMATCHED_ARRAYS_LENGTH
		);
		require(
			_deedNFT != address(0) &&
				// _genesisNFT != address(0) &&
				_founderNFT != address(0) &&
				_mainWallet != address(0) &&
				_deedToken != address(0) &&
				_DaiToEthPriceFeed != address(0),
			INVALID_ADDRESS
		);
		assets = _assets;
		assetsDexPairs = _assetsDexPairs;
		assetsdecimals = _assetsdecimals;
		calculateSumOfRatios(_assetAllocations);
		assetAllocationRatio = _assetAllocations;
		deedNFT = _deedNFT;
		founderNFT = _founderNFT;
		// genesisNFT = _genesisNFT;
		mainWallet = _mainWallet;
		priceFeed = _priceFeed;
		deedToken = _deedToken;
		depositingAddress = _depositingAddress;
		DaiToEthPriceFeed = _DaiToEthPriceFeed;
		WETH = _WETH;
		nonce_ = _nonce;
		owner = _owner;
		_distributedTokenRoot = _assets[0];
		_exchangeContractAddress = exchangeContractAddress;
		ITokenRoot(_distributedTokenRoot).deployWallet{
			value: 0.2 ever,
			flag: 1,
			callback: Treasury.onTokenWallet
		}(address(this), 0.1 ever); // this callback will be called by TokenRoot after deploying wallet for treasury
		// sending remaining gas after setups
		// owner.transfer({value: 0, flag: 128, bounce: false});
	}

	function onTokenWallet(address value) external {
		require(
			msg.sender.value != 0 && msg.sender == _distributedTokenRoot,
			101
		);
		// tvm.rawReserve(1 ever, 0);
		_distributedTokenWallet = value; // store deployed tip3 wallet address
		require(_distributedTokenWallet != address(0), INVALID_ADDRESS);
		owner.transfer({value: 0, flag: 128, bounce: false}); // sending remaining gas after setups
	}

	 function onAcceptTokensTransfer(
        address tokenRoot,
        uint128 amount,
        address sender,
        address senderWallet,
        address remainingGasTo,
        TvmCell payload
    ) external override {

        rootToWallet[tokenRoot] = msg.sender;
        remainingGasTo.transfer({
            value: 0,
            flag: 64
        });

    }

	function calculateSumOfRatios(uint8[] _ratios) public pure {
		// require(_ratios.length == 5, "Need ratios for 5 assets");
		uint8 sum = 0;
		uint n = _ratios.length;
		for (uint8 i = 0; i < n; i++) {
			sum += _ratios[i];
		}
		require(sum == 100, INVALID_RATIO);
	}

	// Error codes
	uint16 public constant ONLY_OWNER_CAN_CALL = 226;
	uint16 public constant NOT_OWNER_OR_GOVERNANCE = 227;
	uint16 public constant NOT_DEPOSITING_ADDRESS_OR_OWNER = 228;

	modifier onlyGovernance() {
		require(msg.sender == governance, ONLY_OWNER_CAN_CALL);
		_;
	}

	modifier onlyOwnerOrGovernance() {
		require(
			msg.sender == owner || msg.sender == governance,
			NOT_OWNER_OR_GOVERNANCE
		);
		_;
	}

	modifier onlyOwnerOrDepositingAddress() {
		require(
			msg.sender == owner || msg.sender == depositingAddress,
			NOT_DEPOSITING_ADDRESS_OR_OWNER
		);
		_;
	}
	uint16 public constant NO_DEPOSITS_FOUND = 219;

	function getEligibleWithdrawDetails(
		address _userAddress
	) external view returns (uint256[], User[]) {
		uint256 userDepositCount = userDeposits[_userAddress].length;
		require(userDepositCount > 0, NO_DEPOSITS_FOUND);

		uint256 eligibleCount = 0;

		// Calculate how many eligible deposits there are
		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleCount++;
			}
		}

		// Create arrays to store eligible indices and User details
		uint256[] eligibleIndices = new uint256[](eligibleCount);
		User[] eligibleUsers = new User[](eligibleCount);
		uint256 index = 0;

		// Populate arrays with the eligible indices and User details
		for (uint256 i = 0; i < userDepositCount; i++) {
			if (
				userDeposits[_userAddress][i].treasuryDeposit > 0 &&
				block.timestamp >=
				userDeposits[_userAddress][i].firstDepositTime +
					FULL_TERM_LOCK_PERIOD
			) {
				eligibleIndices[index] = i;
				eligibleUsers[index] = userDeposits[_userAddress][i];
				index++;
			}
		}

		return (eligibleIndices, eligibleUsers);
	}

	uint16 public constant LENGTH_MISMATCH = 229;
	uint16 public constant TRANSFER_FAILED = 230;

	function onDeployWallet(address _wallet) public {
		require(msg.sender == assets[0], 166);
		require(_wallet != address(0), 132);
		assetsZeroWallet = _wallet;
	}

	function setMainTokenWallet(address _mainTokWallet) public {
		mainTokenWallet = _mainTokWallet;
	}

	function deposit_admin(
		address[] users,
		uint256[] daiAmounts
	) external onlyOwnerOrDepositingAddress {
		require(users.length == daiAmounts.length, LENGTH_MISMATCH);
		TvmCell e;
		uint256 totalAmount = calculateTotalDeposit(users, daiAmounts);
		uint256 daiAmountToSwap = totalAmount;

		// ITokenRoot(assets[0]).deployWallet{
		// 	value: 2_000_000_000,
		// 	callback: onDeployWallet
		// }(this, 100000);

		// ITokenRoot(assets[0]).walletOf{
		// 	value: 2_000_000_000,
		// 	callback: setMainTokenWallet
		// }(owner);

		// require(mainTokenWallet != address(0), 224);

		ITokenWallet(_distributedTokenWallet).transfer({
			amount: 10,
			recipient: address(this),
			deployWalletValue: 10000,
			remainingGasTo: owner,
			notify: true,
			payload: e
		});

		// bool success = IERC20(assets[0]).transferFrom(
		// 	msg.sender,
		// 	address(this),
		// 	totalAmount
		// );
		// require(success, "Transfer to treasury failed");

		//swapping and splitting wiill be done here
		deposit(daiAmountToSwap);

		// Loop through each user to update their deposit records
		uint256 lengthh = users.length;
		for (uint256 i = 0; i < lengthh; i++) {
			User newUserDeposit = User({
				treasuryDeposit: daiAmounts[i],
				firstDepositTime: block.timestamp
			});

			// Push the new deposit entry into the userDeposits array
			userDeposits[users[i]].push(newUserDeposit);

			// Update the overall treasury balance
			treasuryBalances[users[i]] += daiAmounts[i];
			// updateTopTreasuryHolders(users[i]);
		}

		// Update total treasury points
		totalTreasuryPoints += totalAmount;
		emit DepositBatch(lengthh, totalAmount);
	}

	// *****************************************************************//
	  event SwapSuccess(uint64 queyId ,IExchangeResult.ExchangeResult result);
    event madeSwap(address tokenIn,address tokenOut,uint128 amount);
    mapping(address => address) public rootToWallet;

	 uint16 constant WALLET_NOT_EXISTS = 101;
    uint16 constant NOT_ENOUGH_VALUE = 102;

	 function makeSwap(
        uint64 queryId,
        address tokenIn,
        uint128 amountIn,
        address tokenOut,
        address pair,
        uint128 deployWalletValue,
        uint128 expectedAmountOut,
        address treasuryAddress
    ) public {
        address tokenWallet = rootToWallet[tokenIn];
        require(address.makeAddrNone() != tokenWallet, WALLET_NOT_EXISTS);
        IGasValueStructure.GasValue gas = GasValues.getPoolDirectExchangeGas(0.1 ever, address(0));
        uint128 gasValue = gas.dynamicGas + gas.fixedValue;
        require(msg.value >= gasValue, NOT_ENOUGH_VALUE);
        TvmCell e;
        TvmCell swapPayload = PairPayload.buildExchangePayloadV2(
            queryId,
            deployWalletValue,
            expectedAmountOut,
            treasuryAddress,
            tokenOut,
            address(0),
            e,
            e,
            null
        );

        ITokenWallet(tokenWallet).transfer{value: 0, flag: 64}(
            amountIn,
            pair,
            deployWalletValue,
            treasuryAddress,
            true,
            swapPayload
        );
        // Treasury(treasuryAddress).onSwapComplete();
    emit madeSwap(tokenIn,tokenOut,amountIn);


        
    }
function dexPairExchangeSuccess(uint64 id, bool via_account, IExchangeResult.ExchangeResult result) external {
        // will be call before tokens actually transferred
        emit SwapSuccess(id, result);
    }
	// *****************************************************************//

	function deposit(uint256 daiAmount) public {
		// Approve DAI for the swap router
		// TransferHelper.safeApprove(assets[0], SWAP_ROUTER_02, daiAmount);

		// Calculate the amount of DAI to be swapped for each asset
		uint256 n = assets.length;

		uint256 primaryLockingAmount = (daiAmount * assetAllocationRatio[0]) / 100;
		primaryTokenLockedAmount+=primaryLockingAmount;

		for (uint256 i = 1; i < n; i++) {
			uint256 amountIn = (daiAmount * assetAllocationRatio[i]) / 100;
			// uint8 decimals = uint8(assetsdecimals[i];)
			// uint256 amountinusd = (amountIn * 10 ** 8) / (10 ** 18);
			// uint256 examountout = 100; //fetchUsdIntoAssetsPrice(i, amountinusd);
			// // uint256 slipage = 5;
			// uint256 slipageamount = (examountout * maxslippage) / 100;
			// uint256 minamountout = examountout - slipageamount;

			// require(minamountout > 0, SLIPPAGE_TOO_HIGH);

			makeSwap(
				1,
				assets[0],
				uint128(amountIn),
				assets[i],
				assetsDexPairs[i - 1],
				1 ever,
				0,
				address(this)
			);
			// Adjust for decimals of the asset
			// swapExactInputSingle(
			// 	assets[0],
			// 	assets[i],
			// 	amountIn,
			// 	poolFeeTier[i - 1],
			// 	minamountout
			// );
		}
	}

	uint16 public constant ZERO_AMOUNT = 231;
	uint16 public constant INVALID_USER = 232;

	function calculateTotalDeposit(
		address[] users,
		uint256[] daiAmounts
	) public pure returns (uint256 totalAmount) {
		uint256 _totalAmount = 0;
		uint256 n = daiAmounts.length;

		for (uint256 i = 0; i < n; i++) {
			require(daiAmounts[i] > 0, ZERO_AMOUNT);
			require(users[i] != address(0), INVALID_USER);

			_totalAmount += daiAmounts[i];
		}
		return _totalAmount;
	}

	uint16 public constant SLIPPAGE_TOO_HIGH = 233;

	// function fetchUsdIntoAssetsPrice(
