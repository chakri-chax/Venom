	uint16 public constant INVALID_INDEX = 234;
	uint16 public constant DEPOSIT_NOT_ELIGIBLE = 235;
	uint16 public constant NO_VALID_DEPOSITS = 236;

	function withdraw(uint256[] indices) external {
		uint256 totalAmount;

		uint256 userDepositCount = userDeposits[msg.sender].length;
		require(userDepositCount > 0, NO_VALID_DEPOSITS);

		// Calculate total amount eligible for withdrawal
		uint256 cnt = indices.length;
		uint256 userPrimaryTokenUnlockingAmt; // usdt user share

		for (uint256 i = 0; i < cnt; i++) {
			require(indices[i] < userDepositCount, INVALID_INDEX);
			User userDeposit = userDeposits[msg.sender][indices[i]];
			require(
				block.timestamp >=
					userDeposit.firstDepositTime + FULL_TERM_LOCK_PERIOD,
				DEPOSIT_NOT_ELIGIBLE
			);

			uint256 primaryUnLockingAmount = (userDeposit.treasuryDeposit * assetAllocationRatio[0]) / 100;
			userPrimaryTokenUnlockingAmt+=primaryUnLockingAmount;
			primaryTokenLockedAmount -= primaryUnLockingAmount; // unlocking usdt amount

			totalAmount += userDeposit.treasuryDeposit; //in Usdt 6 decimals
			userDeposit.treasuryDeposit = 0;
			userDeposit.firstDepositTime = 0; // Set deposit to 0 to prevent double withdrawal
			
		}
		require(totalAmount > 0, NO_VALID_DEPOSITS);

		// Calculate total user deposit assets in USDT after a year
		uint256 totalAmountInUsd;
		uint256 len = assets.length;

		for (uint256 i = 0; i < len; i++) {
			// uint256 treasuryBal = 100; //IERC20(assets[i]).balanceOf(address(this));
			// uint256 userShare = (treasuryBal * totalAmount) /
			// totalTreasuryPoints; //in asset decimals
			uint256 userShare = totalAmount; 
			uint256 assetPriceInUsd;

			// if (assets[i] == WETH) {
			//     // Special case for WETH
			//     uint256 wethPriceInDai = getWethToDaiAmount(
			//         userShare,
			//         AggregatorV3Interface(DaiToEthPriceFeed)
			//     );
			//     assetPriceInUsd = fetchAssetPriceInUsd(0, wethPriceInDai);
			// } else {
			//     // Fetch asset price in USD
			//     assetPriceInUsd = fetchAssetPriceInUsd(i, userShare);
			// }

			totalAmountInUsd += assetPriceInUsd;
			uint256 assetPriceindai = (assetPriceInUsd * 10 ** 18) / 10 ** 8;
			uint256 slipageamount = (assetPriceindai * maxslippage) / 100;
			uint256 minamountout = assetPriceindai - slipageamount;
			
			if (assets[i] == assets[0]) {
				// IERC20(assets[0]).transfer(mainWallet, userShare);
				// transfer usdt user share to mainWallet
			uint256 share = (userShare * assetAllocationRatio[0])/100;
			TvmCell e;
				ITokenWallet(_distributedTokenWallet).transfer({
					amount: uint128(share),
					recipient: mainWallet,
					deployWalletValue: 10000,
					remainingGasTo: owner,
					notify: true,
					payload: e
					});

			} else {
				emit swaplog(assets[i], assets[0], userShare);
				uint256 userDaiShare = (userShare * assetAllocationRatio[i])/100;

				uint256 swapAmt = usdtRate(i,userShare);

				makeSwap(
				1,
				assets[i],
				uint128(swapAmt),
				assets[0],
				assetsDexPairs[i - 1],
				1 ever,
				0,
				address(this)
			);
				// uint256 usershareInDai = swap(
				//     assets[i],
				//     assets[0],
				//     userShare,
				//     poolFeeTier[i - 1],
				//     minamountout
				// );
				// IERC20(assets[0]).transfer(mainWallet, usershareInDai);
			}
			// q should transfer only usershare or userShareInDai
		}

		uint256 totalamount2 = totalAmount;
		uint256 totalDepositInUsd = fetchAssetPriceInUsd(0, totalamount2);

		// // Determine fee percentage
		uint256 feePercentage = totalAmountInUsd > (totalDepositInUsd * 2)
			? 20
			: 10;
		uint256 totalAmountInDaiSwap = 100; //getUsdToDaiAmount(
		//     totalAmountInUsd,
		//     AggregatorV3Interface(priceFeed[0])
		// );

		uint256 feeAmount;
		uint256 amountAfterFee;
		uint256 daiAmountToMint;
		if (totalamount2 < totalAmountInDaiSwap) {
			feeAmount = (totalAmountInDaiSwap * feePercentage) / 100;

			amountAfterFee = totalAmountInDaiSwap - feeAmount;

			daiAmountToMint =
				(amountAfterFee * DEED_EMISSION_RATE * 10 ** 8) /
				(10 ** 18);
		} else {
			feeAmount = (totalamount2 * feePercentage) / 100;

			amountAfterFee = totalamount2 - feeAmount;

			daiAmountToMint =
				(amountAfterFee * DEED_EMISSION_RATE * 10 ** 8) /
				(10 ** 18);
		}

		IDeedToken(deedToken).mintForTreasury(msg.sender, daiAmountToMint);

		totalTreasuryPoints -= totalAmount;
		// Update treasury points for user
		treasuryBalances[msg.sender] -= totalAmount;

		// // Remove withdrawn deposits from userDeposits array
		removeUserDeposits(msg.sender, indices);
		emit Withdraw(msg.sender, totalAmount, daiAmountToMint);
	}
	function usdtRate(uint16 index,uint256 _usdtAmount) public returns (uint256 daiAmount) {
        // Scale USDT to 18 decimals before applying rate
		uint256 RATE ;
		if(index == 1){
				RATE = 949038394185496310;
		}
		
        uint256 usdt18 = _usdtAmount * 1e12; 

        daiAmount = (usdt18 * RATE) / 1e18;
    }

	uint16 public constant INVALID_ASSET_INDEX = 237;

	function fetchAssetPriceInUsd(
		uint256 assetIndex,
		uint256 assetAmount
	) public view returns (uint256) {
		require(assetIndex < assets.length, INVALID_ASSET_INDEX);

		AggregatorV3Interface pricefeed = AggregatorV3Interface(
			priceFeed[assetIndex]
		);
		uint8 decimals = uint8(assetsdecimals[assetIndex]);
		return getAmountInUsd(assetAmount, pricefeed, decimals);
	}

	uint16 public constant INVALID_PRICE = 238;

	function getAmountInUsd(
		uint256 assetAmount,
		AggregatorV3Interface pricefeed,
		uint8 decimals
	) internal view returns (uint256) {
		// Fetch the latest price from the price feed
		// (, int256 price, , , ) = pricefeed.latestRoundData();
		uint256 price = 100;
		require(price > 0, INVALID_PRICE);

		// Convert asset amount to USD using the price and decimals
		return (assetAmount * uint256(price)) / (10 ** uint256(decimals));
	}

	uint16 public constant INDEX_OUT_OF_BOUNDS = 239;

	function removeUserDeposits(address user, uint256[] indices) internal {
		require(indices.length > 0, NO_DEPOSITS_FOUND);

		// Sort the indices in ascending order to avoid shifting issues
		sortAscending(indices);

		uint256 originalLength = userDeposits[user].length;
		bool[] skip = new bool[](originalLength); // Skip list to mark removal

		// Mark the elements that need to be removed by setting skip flags
		for (uint256 i = 0; i < indices.length; i++) {
			uint256 index = indices[i];
			require(index < originalLength, INDEX_OUT_OF_BOUNDS);

			// Mark the index for removal
			skip[index] = true;
		}

		// Count how many elements will remain after removal
		uint256 remainingCount;
		for (uint256 i = 0; i < originalLength; i++) {
			if (!skip[i]) {
				remainingCount++;
			}
		}

		// Create a new array to store remaining elements
		//// uint256[]  newDeposits = new uint256[](remainingCount);
		User[] newDeposits = new User[](remainingCount);
		uint256 j;
		for (uint256 i = 0; i < originalLength; i++) {
			if (!skip[i]) {
				newDeposits[j] = userDeposits[user][i];
				j++;
			}
		}

		// Replace the original array with the new one
		userDeposits[user] = newDeposits;
	}

	function sortAscending(uint256[] data) internal pure {
		uint256 n = data.length;
		for (uint256 i = 0; i < n; i++) {
			for (uint256 j = i + 1; j < n; j++) {
				if (data[i] > data[j]) {
					// Swap values
					(data[i], data[j]) = (data[j], data[i]);
				}
			}
		}
	}

	function getCallbackAmouhnt() public {
		msg.sender.transfer({value: 1 ever, flag: 128, bounce: false});
	}

	fallback() external {
    tvm.accept();
    // Optional logging here
}
}
