			makeSwap(
				15,
				assets[0],
				uint128(2),
				assets[1],
				assetsDexPairs[1],
				1 ever,
				0,
				address(this)
			);
			emit asset1SwapEvnet(assets[0],assets[1],assetsDexPairs[1],uint128(2));
}
function _asset2Swap() public {
			makeSwap(
				16,
				assets[0],
				uint128(2),
				assets[2],
				assetsDexPairs[2],
				1 ever,
				0,
				address(this)
			);
			emit asset1SwapEvnet(assets[0],assets[2],assetsDexPairs[2],uint128(2));
}
function asset3Swap() public {
			makeSwap(
				17,
				assets[0],
				uint128(1),
				assets[3],
				assetsDexPairs[3],
				1 ever,
				0,
				address(this)
			);
			emit asset1SwapEvnet(assets[0],assets[3],assetsDexPairs[3],uint128(1));
}
 function onAcceptTokensTransfer(
        address tokenRoot,
        uint128 amount,
        address sender,
        address senderWallet,
        address remainingGasTo,
        TvmCell payload
    ) external override {

        rootToWallet[tokenRoot] = msg.sender;
        remainingGasTo.transfer({
            value: 0,
            flag: 64
        });

    }
