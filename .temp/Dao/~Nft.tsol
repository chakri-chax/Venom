pragma ever-solidity >= 0.62.0;
pragma AbiHeader expire;
pragma AbiHeader pubkey;

// importing all standards bases
// import '@broxus/tip4/contracts/TIP4_1/~TIP4_1Nft.tsol';
// import '@broxus/tip4/contracts/TIP4_2/~TIP4_2Nft.tsol';
// import '@broxus/tip4/contracts/TIP4_3/~TIP4_3Nft.tsol';

import "/home/gaian/venomChain/Venom/node_modules/@broxus/tip4/contracts/TIP4_1/TIP4_1Nft.tsol";
import "/home/gaian/venomChain/Venom/node_modules/@broxus/tip4/contracts/TIP4_2_2/TIP4_2_2Nft.tsol";
import "/home/gaian/venomChain/Venom/node_modules/@broxus/tip4/contracts/TIP4_3/TIP4_3Nft.tsol";


contract Nft is TIP4_1Nft, TIP4_2_2Nft, TIP4_3Nft {

    address public  nftOwner;
    // just call constructors of all implemented classes
    //  address owner,
    //     address sendGasTo,
    //     uint128 remainOnNft,
    //     uint256 nftId_,
    //     string typeName_,
    //     string nickName_,
    //     uint128 indexDeployValue,
    //     uint128 indexDestroyValue,
    //     TvmCell codeIndex  
    constructor(
        address owner,
        address sendGasTo,
        uint128 remainOnNft,
        TvmCell codeIndex, // for TIP-4.3
        uint128 indexDeployValue, // for TIP-4.3
        uint128 indexDestroyValue // for TIP-4.3
    ) TIP4_1Nft(
        owner,
        sendGasTo,
        remainOnNft
    ) TIP4_3Nft (
        indexDeployValue,
        indexDestroyValue,
        codeIndex
    ) public {
        nftOwner = owner;
    }


   function _beforeTransfer(
        address /*to*/,
        address sendGasTo, 
        mapping(address => CallbackParams) /*callbacks*/
    ) internal virtual override(TIP4_1Nft, TIP4_3Nft) {
        TIP4_3Nft._destructIndex(sendGasTo);
    }

    function _afterTransfer(
        address  /*to*/, 
        address  /*sendGasTo*/, 
        mapping(address => CallbackParams) callbacks
    ) internal virtual override(TIP4_1Nft, TIP4_3Nft) {
        TIP4_3Nft._deployIndex();
    }

    function _beforeChangeOwner(
        address /*oldOwner*/, 
        address /*newOwner*/,
        address sendGasTo, 
        mapping(address => CallbackParams) callbacks
    ) internal virtual override(TIP4_1Nft, TIP4_3Nft) {
        TIP4_3Nft._destructIndex(sendGasTo);
    }   

    function _afterChangeOwner(
        address /*oldOwner*/, 
        address /*newOwner*/,
        address /*sendGasTo*/, 
        mapping(address => CallbackParams) callbacks
    ) internal virtual override(TIP4_1Nft, TIP4_3Nft) {
        TIP4_3Nft._deployIndex();
    }

    function _beforeChangeManager(
        address oldManager,
        address newManager,
        address sendGasTo,
        mapping(address => CallbackParams) callbacks
    ) internal override virtual {
        oldManager; newManager; sendGasTo; callbacks; //disable warnings
    }

    function _afterChangeManager(
        address oldManager,
        address newManager,
        address sendGasTo,
        mapping(address => CallbackParams) callbacks
    ) internal override virtual {
        oldManager; newManager; sendGasTo; callbacks; //disable warnings
    }

}