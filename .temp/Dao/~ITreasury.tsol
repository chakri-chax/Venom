pragma ever-solidity >=0.62.0;
import "./~ILockedNFT.tsol";

interface ITreasury {
     function getTreasuryBalance(address _user)
        external
        view
        responsible
        returns (uint256 value, address user);

    function getLockedNFTBalances(address _user)
        external
        view
        responsible
        returns (LockedNFTBalances balances, address user);
}

